# MongoDB Atlas connection string (free M0 tier is plenty)
# Atlas -> Connect -> Drivers -> copy, then replace <password> with the real one
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/peoples?retryWrites=true&w=majority

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

PORT=4000

# Signature at the bottom of every outreach message
SENDER_SIGNATURE=Vikram, Codevani

# Days to wait before a lead shows up in the follow-up queue
FOLLOW_UP_DAYS=3

# Soft daily cap shown in the UI. Above ~30/day WhatsApp bans get likely.
DAILY_SEND_CAP=30

# Optional. Without it the insights page still works, just without the
# written analysis. Get one at console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...
