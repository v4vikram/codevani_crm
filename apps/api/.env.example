# MongoDB Atlas connection string (free M0 tier is plenty)
# Atlas -> Connect -> Drivers -> copy, then replace <password> with the real one
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/peoples?retryWrites=true&w=majority

# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

PORT=4000

# Signature at the bottom of every outreach message
SENDER_SIGNATURE=Vikram, Codevani

# Days to wait before a lead shows up in the follow-up queue
FOLLOW_UP_DAYS=3

# Soft daily cap shown in the UI. Above ~30/day WhatsApp bans get likely.
DAILY_SEND_CAP=30

# Optional. Without it the insights page still works, just without the
# written analysis. Get one at console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Signs session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses to boot with the dev default.
JWT_SECRET=dev-only-insecure-secret-change-me-in-production

# Required to create accounts after the first one. Leave unset to keep
# registration closed once you have signed up.
# SIGNUP_CODE=

# Password-reset emails are sent from this Gmail account.
# 1. Turn on 2-step verification: https://myaccount.google.com/security
# 2. Create an app password:      https://myaccount.google.com/apppasswords
# Use that 16-character code here, NOT your Gmail password. Without these the
# reset link is printed to the API console instead (fine for local dev).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop

# Where the web app lives; reset links point here. Use your Vercel URL in production.
APP_URL=http://localhost:3000
